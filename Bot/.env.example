# TCS iON Credentials — copy to .env and fill (never commit .env)
TCS_USERNAME=your_username
TCS_PASSWORD=your_password

# Optional overrides (defaults shown)
TCS_Loginpage=https://training.tcsion.com/Login/Login.html
TCS_Homepages=https://mfg3.tcsion.com/TCSiONHome/Home
TCS_Manufacturingpage=https://mfg3.tcsion.com/Manufacturing/Manufacturing

# Bot behavior
HEADLESS=true
PR_MAX_ATTEMPTS=3
PR_RETRY_DELAY=60
