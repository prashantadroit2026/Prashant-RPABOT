# Google Sheets
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json   # path to the JSON key
GOOGLE_SHEET_ID=your_spreadsheet_id_here             # from the sheet URL

# Optional
HOST=0.0.0.0
PORT=8080
DEBUG=true
SEED_ON_START=true

# CORS – JSON array of allowed origins (restrict in production)
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# CORS_ALLOW_CREDENTIALS=false
